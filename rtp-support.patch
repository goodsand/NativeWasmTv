@@ -8244,6 +8285,62 @@ public final class MainActivity extends Activity {
                 ? RTSP_TRANSPORT_UDP : RTSP_TRANSPORT_TCP;
     }
 
+    /** Acquire a Wi-Fi multicast lock while a multicast RTP/UDP stream plays.
+     *  Without it, many Android Wi-Fi chipsets drop group traffic in power-save
+     *  mode and the receiver never sees a single packet. */
+    private void acquireRtpMulticastLock(String streamUrl) {
+        if (rtpMulticastLock != null && rtpMulticastLock.isHeld()) return;
+        if (!isMulticastStreamHost(streamUrl)) return;
+        try {
+            WifiManager wifiManager = (WifiManager) getApplicationContext()
+                    .getSystemService(Context.WIFI_SERVICE);
+            if (wifiManager == null) return;
+            rtpMulticastLock = wifiManager.createMulticastLock("nTvRtp");
+            rtpMulticastLock.setReferenceCounted(false);
+            rtpMulticastLock.acquire();
+            Log.i(TAG, "Acquired Wi-Fi multicast lock for " + streamUrl);
+        } catch (RuntimeException error) {
+            Log.w(TAG, "Unable to acquire multicast lock", error);
+        }
+    }
+
+    private void releaseRtpMulticastLock() {
+        if (rtpMulticastLock != null && rtpMulticastLock.isHeld()) {
+            try { rtpMulticastLock.release(); } catch (RuntimeException ignored) { }
+            Log.i(TAG, "Released Wi-Fi multicast lock");
+        }
+        rtpMulticastLock = null;
+    }
+
+    /** True when the host of an rtp://, udp:// or srtp:// URL is a multicast address
+     *  (IPv4 224.0.0.0-239.255.255.255 or IPv6 ff00::/8). Unicast streams never need
+     *  the multicast lock and must not acquire it. */
+    private static boolean isMulticastStreamHost(String streamUrl) {
+        if (streamUrl == null) return false;
+        // Multicast URLs keep the leading '@' (e.g. rtp://@239.0.0.1:5004).
+        int schemeEnd = streamUrl.indexOf("://");
+        if (schemeEnd < 0) return false;
+        String rest = streamUrl.substring(schemeEnd + 3);
+        int at = rest.indexOf('@');
+        String host = at >= 0 ? rest.substring(at + 1) : rest;
+        int colon = host.indexOf(':');
+        if (colon >= 0) host = host.substring(0, colon);
+        int slash = host.indexOf('/');
+        if (slash >= 0) host = host.substring(0, slash);
+        if (host.length() == 0) return false;
+        if (Character.isDigit(host.charAt(0))) {
+            String[] parts = host.split("\\.");
+            if (parts.length == 4) {
+                try {
+                    int first = Integer.parseInt(parts[0]);
+                    return first >= 224 && first <= 239;
+                } catch (NumberFormatException ignored) { }
+            }
+            return false;
+        }
+        return host.toLowerCase(Locale.US).startsWith("ff");
+    }
