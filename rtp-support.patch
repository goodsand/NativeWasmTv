+    /** RTP/UDP (and SRTP) are realtime native transports handled directly by IJK/FFmpeg,
+     *  exactly like RTSP. They must bypass the HLS proxy and the Android platform player. */
+    private static boolean isRtpUdpSource(String sourceUrl) {
+        if (sourceUrl == null) {
+            return false;
+        }
+        String value = sourceUrl.trim().toLowerCase(Locale.US);
+        return value.startsWith("rtp://") || value.startsWith("udp://")
+                || value.startsWith("srtp://");
+    }
+
     private static boolean isNativeStreamingSource(String sourceUrl) {
-        return isRtmpSource(sourceUrl) || isRtspSource(sourceUrl);
+        return isRtmpSource(sourceUrl) || isRtspSource(sourceUrl) || isRtpUdpSource(sourceUrl);
     }
 
